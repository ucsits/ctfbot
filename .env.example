# ================================================================
# CTFBot Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ----------------------------------------------------------------
# Discord Bot Configuration (REQUIRED)
# ----------------------------------------------------------------

# Your Discord bot token from https://discord.com/developers/applications
# 1. Go to Discord Developer Portal
# 2. Select your application
# 3. Go to "Bot" section
# 4. Click "Reset Token" or "Copy" to get your token
DISCORD_TOKEN=your_discord_bot_token_here

# ----------------------------------------------------------------
# Development Configuration (OPTIONAL)
# ----------------------------------------------------------------

# Guild (Server) ID for instant command registration during development
# When set, slash commands will appear instantly in this server
# When empty, commands are registered globally (takes up to 1 hour)
# To get your server ID: Enable Developer Mode in Discord > Right-click server > Copy ID
GUILD_ID=

# Environment mode (development, production, staging)
NODE_ENV=development

# Bot owner IDs (comma-separated Discord user IDs)
# These users will have access to owner-only commands (if implemented)
# Example: OWNERS=123456789012345678,987654321098765432
OWNERS=

# ----------------------------------------------------------------
# Admin Configuration (OPTIONAL)
# ----------------------------------------------------------------

# Admin user IDs (comma-separated Discord user IDs)
# Users with these IDs will bypass all permission checks and have full access.
# When set in environment, this takes precedence over the database.
# Example: ADMIN_IDS=123456789012345678,987654321098765432
# Default: 470159562918592512
ADMIN_IDS=470159562918592512

# ----------------------------------------------------------------
# CTF Configuration (REQUIRED)
# ----------------------------------------------------------------

# Category ID where CTF channels will be created
# 1. Create a category in your Discord server (e.g., "CTF Competitions")
# 2. Right-click the category > Copy ID (Developer Mode must be enabled)
# 3. Paste the ID here
CTF_CATEGORY_ID=

# ----------------------------------------------------------------
# CTF Platform Credentials (OPTIONAL)
# ----------------------------------------------------------------

# Platform credentials are NOT read from the environment. They are stored per
# CTF in the database and set from Discord with /setctfplatform, because two
# CTFs running at the same time can use different platforms with different
# tokens:
#
#   /setctfplatform platform:ctfd api_token:<token>
#   /setctfplatform platform:noctf api_base_url:https://api-k17ctf.secso.cc api_token:<token> division_id:2
#   /setctfplatform show:true
#
# CTFd sends the token as `Authorization: Token <api_token>` and serves its API
# from the same origin as its web UI, so api_base_url can be left unset.
# noCTF sends it as `Authorization: Bearer <token>` from a separate API origin
# and scopes its scoreboard to a division, so both api_base_url and division_id
# are usually needed. A noCTF session token lasts 7 days and cannot be
# refreshed, so it has to be replaced periodically with /setctfplatform.
#
# CTFD_API_TOKEN is no longer read by the bot; per-CTF platform credentials
# replaced it. It is left here so an existing .env keeps a familiar key.
CTFD_API_TOKEN=

# ----------------------------------------------------------------
# Database Configuration (OPTIONAL)
# ----------------------------------------------------------------

# ----------------------------------------------------------------
# Luce Blockchain Configuration (OPTIONAL)
# ----------------------------------------------------------------

# Port where the Luce blockchain RPC server is listening (default: 5500)
# The blockchain is assumed to run on the same machine (localhost-only RPC)
LUCE_PORT=5500

# ----------------------------------------------------------------
# Google Calendar Bidirectional Sync (OPTIONAL)
# ----------------------------------------------------------------

# Enable Google Calendar sync for tasks (true/false)
# GOOGLE_CALENDAR_ENABLED=false

# OAuth 2.0 credentials — create a Google Cloud Project, enable the Calendar
# API, and create an OAuth 2.0 Client ID (Desktop app type). Use the helper
# script or the auth URL to obtain a refresh token with the calendar scope.
# GOOGLE_CLIENT_ID=your_client_id_here
# GOOGLE_CLIENT_SECRET=your_client_secret_here

# Shared Google Calendar ID (e.g. "primary" or "abc123@group.calendar.google.com")
# GOOGLE_CALENDAR_ID=your_calendar_id_here

# Long-lived refresh token obtained via the one-time OAuth consent flow.
# GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# ----------------------------------------------------------------
# Database Configuration (OPTIONAL)
# ----------------------------------------------------------------

# Database file name (default: ctfbot.db)
# The database file will be created in the project root
# DATABASE_FILE=ctfbot.db

# ----------------------------------------------------------------
# Logging Configuration (OPTIONAL)
# ----------------------------------------------------------------

# Log level controls the verbosity of console output.
# Available levels (least to most verbose): error, warn, info, debug, trace
# - error:   Only fatal errors
# - warn:    Errors + warnings
# - info:    Normal operational messages (default)
# - debug:   Detailed debugging information
# - trace:   Everything including CTF platform HTTP request tracing
LOG_LEVEL=info

# Enable verbose logging for Sapphire framework internals
# Set to true when debugging framework-level issues
# VERBOSE_LOGGING=false
