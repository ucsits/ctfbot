{
	"env": {
		"node": true,
		"es2021": true
	},
	"extends": "eslint:recommended",
	"parserOptions": {
		"ecmaVersion": 2021,
		"sourceType": "module"
	},
	"rules": {
		// Indentation is Prettier's job. This rule cannot agree with it on switch
		// cases or on ternaries and object literals continued over several lines,
		// and it is deprecated in ESLint 8 and removed in ESLint 9, so keeping it
		// on only ever produced errors that no formatting could satisfy.
		"indent": "off",
		"linebreak-style": ["error", "unix"],
		// A string that contains a single quote is written with double quotes,
		// which is what Prettier emits for it; avoidEscape is what lets the two
		// agree instead of contradicting each other.
		"quotes": ["error", "single", { "avoidEscape": true }],
		"semi": ["error", "always"],
		"no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
		"no-console": "off",
		"prefer-const": "error",
		"no-var": "error",
		"eqeqeq": ["error", "always"],
		"curly": ["error", "all"],
		"brace-style": ["error", "1tbs"],
		"comma-dangle": ["error", "never"],
		"arrow-spacing": "error",
		"space-before-blocks": "error",
		"keyword-spacing": "error",
		"space-infix-ops": "error",
		"no-trailing-spaces": "error",
		"eol-last": ["error", "always"],
		"object-curly-spacing": ["error", "always"]
	}
}
